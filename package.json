{
  "name": "docs-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "gen-api": "docusaurus clean-api-docs all && docusaurus gen-api-docs all && node scripts/stamp-api-docs.mjs",
    "start": "npm run sync && npm run gen-api && docusaurus start",
    "build": "npm run sync && npm run gen-api && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.52.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "^5.2.0",
    "docusaurus-theme-openapi-docs": "^5.2.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.0"
  }
}
